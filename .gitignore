# Keep personal, sensitive and generated files out of this public repository.
# Tracked files are only the skill's own Markdown, Python, JSON and bundled assets;
# anything else must be added on purpose, with a rule below changed to allow it.

# Secrets, keys and credentials
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keychain*
id_rsa*
id_ed25519*
*credentials*
*secret*
*token*
.netrc
.npmrc
.pypirc
.envs/
*.p8
AuthKey_*
*service-account*.json
*.mobileprovision
*.jks
*.keystore

# Local tool and editor state, which can hold your user name and folder paths
.claude/
CLAUDE.local.md
.DS_Store
._*
__MACOSX/
Thumbs.db
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.idea/
.vscode/
*.swp
*~

