    {"key": "approved", "source": "payment", "target": "orders", "label": "approved", "pattern": "dashed", "end_ending": "arrow"},
    {"key": "declined", "source": "payment", "target": "orders", "label": "declined", "pattern": "dashed", "end_ending": "arrow"},
    {"source": "orders", "target": "shop", "label": "order status", "pattern": "dashed", "end_ending": "arrow"},
    {"source": "shop", "target": "customer", "label": "confirmation", "pattern": "dashed", "end_ending": "arrow"}
   ]
  }
 ]
