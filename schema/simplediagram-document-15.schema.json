     "type": "integer"
    }
   },
   "required": [
    "location",
    "length"
   ],
   "title": "TextRange",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "The whole of `document.json`: these nine keys, all required, and from schema 15\n`required_libraries` when the document names any.",
 "properties": {
  "id": {
   "description": "A UUID in 8-4-4-4-12 form. The app writes upper case; either case opens.",
   "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
   "title": "Id",
   "type": "string"
  },
  "schema_version": {
   "description": "14 for package format 15, 15 for package format 16. Schema 15 is written only with required_libraries.",
   "enum": [
    14,
    15
   ],
   "title": "Schema Version",
   "type": "integer"
  },
  "revision": {
   "description": "Edit counter. A new document is 0.",
   "maximum": 1000000000,
   "minimum": 0,
   "title": "Revision",
   "type": "integer"
  },
  "name": {
   "title": "Name",
   "type": "string"
  },
  "selected_page_id": {
   "description": "A UUID in 8-4-4-4-12 form. The app writes upper case; either case opens.",
   "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
   "title": "Selected Page Id",
   "type": "string"
  },
  "pages": {
   "items": {
    "$ref": "#/$defs/Page"
   },
   "maxItems": 100,
   "minItems": 1,
   "title": "Pages",
   "type": "array"
  },
  "quick_styles": {
   "items": {
    "$ref": "#/$defs/QuickStyle"
   },
   "maxItems": 32,
   "title": "Quick Styles",
   "type": "array"
  },
  "embedded_assets": {
   "items": {},
   "maxItems": 0,
   "title": "Embedded Assets",
   "type": "array"
  },
  "shape_data_definitions": {
   "items": {},
   "maxItems": 0,
   "title": "Shape Data Definitions",
   "type": "array"
  },
  "required_libraries": {
   "description": "The downloaded libraries the document's shapes come from. Schema 15 only, and only when not empty; left out otherwise, never null.",
   "items": {
    "$ref": "#/$defs/RequiredLibrary"
   },
   "maxItems": 64,
   "minItems": 1,
   "title": "Required Libraries",
   "type": "array"
  }
 },
 "required": [
  "id",
  "schema_version",
  "revision",
  "name",
  "selected_page_id",
  "pages",
  "quick_styles",
  "embedded_assets",
  "shape_data_definitions"
 ],
 "title": "SimpleDiagrams document.json",
 "type": "object"
}
