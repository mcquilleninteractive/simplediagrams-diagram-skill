     },
     "title": "Paragraph Runs",
     "type": "array"
    },
    "background_hex": {
     "anyOf": [
      {
       "description": "#RRGGBB or #RRGGBBAA. Use #00000000 for transparent; names are invalid.",
       "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Background Hex"
    }
   },
   "required": [
    "string",
    "base_style",
    "character_runs",
    "base_alignment",
    "paragraph_runs"
   ],
   "title": "TextContent",
   "type": "object"
  },
  "TextLayout": {
   "additionalProperties": false,
   "description": "Where a label sits, relative to its own shape.\n\n`frame` is in fractions of the shape: x and y are the region's top left\ncorner and stay inside the shape; width and height may run past it. With\nposition `above` or `below` the label sits just outside the shape and the\nframe's y is ignored.",
