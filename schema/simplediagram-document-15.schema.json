  "RequiredLibrary": {
   "additionalProperties": false,
   "description": "One library a document's shapes come from, so a reader who lacks it is told its name.\n\nThe app has no network access, so the document carries the name beside the identifier.\nThe entry is advisory: the app never draws, places or refuses anything because of it.\nThese rules are the app's own (`DiagramRequiredLibrary`), so a list written here is\nnever trimmed when the app reads it.",
   "properties": {
    "library_id": {
     "description": "The identifier the document's references use for the library: its published UUID. ASCII letters, digits, '.', '-' and '_', beginning and ending with a letter or digit.",
     "maxLength": 256,
     "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
     "title": "Library Id",
     "type": "string"
    },
    "display_name": {
     "description": "The library's name, shown to a person: not blank, with no line breaks, control characters or direction controls.",
     "maxLength": 200,
     "minLength": 1,
     "title": "Display Name",
     "type": "string"
    },
    "minimum_revision": {
     "anyOf": [
      {
       "maximum": 1000000,
       "minimum": 1,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "The lowest library revision holding every shape used, when known.",
     "title": "Minimum Revision"
    }
   },
   "required": [
    "library_id",
    "display_name"
   ],
   "title": "RequiredLibrary",
   "type": "object"
  },
  "SymbolReference": {
   "additionalProperties": false,
   "description": "Names one shape in a library: one built into SimpleDiagrams, or a downloaded one.\n\nA built-in shape is named by the app's own library and item names. A downloaded\nshape is named by its library's and item's published UUIDs; the app puts its\nartwork in place when the document opens with that library installed (from\nSimpleDiagrams 5.1.0), and the document lists the library in `required_libraries`. A\nreference the app cannot resolve still opens, but draws a dashed placeholder.",
   "properties": {
    "library_id": {
     "minLength": 1,
     "title": "Library Id",
     "type": "string"
    },
    "item_id": {
     "minLength": 1,
     "title": "Item Id",
     "type": "string"
    },
    "asset_version": {
     "exclusiveMinimum": 0,
     "maximum": 9223372036854775807,
     "title": "Asset Version",
     "type": "integer"
    }
   },
   "required": [
    "library_id",
    "item_id",
    "asset_version"
   ],
   "title": "SymbolReference",
   "type": "object"
  },
  "TextContent": {
   "additionalProperties": false,
   "description": "The label of an element or connector. Every key except background_hex is required.\n\nRuns are only allowed over plain ASCII text. The app requires each run to\nstart and end between whole user-perceived characters, which for accented\nletters, emoji and other combined characters cannot be checked here.",
   "properties": {
    "string": {
     "title": "String",
     "type": "string"
    },
    "base_style": {
     "$ref": "#/$defs/CharacterStyle"
    },
    "character_runs": {
     "items": {
      "$ref": "#/$defs/CharacterRun"
     },
     "title": "Character Runs",
     "type": "array"
    },
    "base_alignment": {
     "enum": [
      "leading",
      "center",
      "trailing",
      "justified"
     ],
     "title": "Base Alignment",
     "type": "string"
    },
    "paragraph_runs": {
     "items": {
